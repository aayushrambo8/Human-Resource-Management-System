# Copy to .env.local and adjust as needed. All values are optional.

# Server-side proxy target used by the rewrites in next.config.ts. Requests the
# browser sends to /api/backend/... (and /api/...) are forwarded here. This is
# read when the Next.js server starts, so it can change without a rebuild.
# In Docker, docker-compose.yml sets this to http://backend:8080.
API_PROXY_TARGET=http://127.0.0.1:8080

# Only needed for direct cross-origin setups (browser calling the backend
# origin directly instead of the same-origin /api/backend proxy). If set, the
# backend's HRMS_CORS_ALLOWED_ORIGINS must include this app's origin.
# NEXT_PUBLIC_API_URL=http://localhost:8080
